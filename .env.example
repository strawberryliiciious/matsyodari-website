# Copy this file to ".env" (same folder as server.py) and fill it in.
# Lines starting with # are comments. Restart server.py after changing it.

# ---- Admin panel password (http://127.0.0.1:8000/admin) ----
# If left empty, a random password is created on first run and saved in data/admin_password.txt
ADMIN_PASSWORD=

# ---- Where the server listens ----
# HOST=127.0.0.1 keeps it private on your computer. Use 0.0.0.0 on a real server.
HOST=127.0.0.1
PORT=8000

# ---- Email alerts (optional but recommended) ----
# Every enquiry is emailed to MAIL_TO. If the customer gave an email they also get a receipt.
MAIL_TO=matsyodaripvtltd@rediffmail.com
# Example for a Gmail account (create an "App password" in your Google account security settings):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=starttls
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-16-letter-app-password
# MAIL_FROM=yourname@gmail.com
# (SMTP_SECURE can be starttls, ssl or none. Use ssl with port 465.)

# ---- Only change these when the site is online ----
# Pages that may send enquiries to this server from another address (comma separated).
# Opening the site with VS Code Live Server (port 5500) works by default.
# ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Set to 1 when the site runs behind a proxy/HTTPS so real visitor IPs and secure cookies are used.
# TRUST_PROXY=1
# COOKIE_SECURE=1
